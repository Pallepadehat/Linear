# Settings for docker-compose.prod.yml. Copy to .env.prod and pass it with --env-file .env.prod.
# Internal URLs (database, Redis, storage) are wired up by the compose file itself.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where people open the app, and the storage host the browser uploads to.
# Change both (and the ports) when running on another machine or behind a domain.
PUBLIC_URL=http://localhost:8080
STORAGE_PUBLIC_URL=http://localhost:8090
APP_PORT=8080
STORAGE_PORT=8090

# Creates demo@tip.dev / password123 with workspace "Tip". Set to false for a real deployment.
SEED_DEMO=true

# Change for anything beyond a local demo.
POSTGRES_PASSWORD=linear
S3_ACCESS_KEY=linear
S3_SECRET_KEY=linear-storage-secret
LOG_LEVEL=info

# Which images `pull` fetches (built and pushed by .github/workflows/release.yml on main).
IMAGE_REGISTRY=ghcr.io/pallepadehat
IMAGE_TAG=prod

# Optional GitHub App (see README → "GitHub App"). Leave all blank to run without it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
