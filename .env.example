# Copy to .env and adjust. Docker Compose reads this file too.
# Only VITE_* variables reach the browser.

NODE_ENV=development
LOG_LEVEL=info

# --- Docker host ports (change if the defaults are taken, and update the URLs below) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- api, worker ---
DATABASE_URL=postgres://linear:linear@localhost:5432/linear
# Optional; defaults to DATABASE_URL with the database name replaced by linear_test
TEST_DATABASE_URL=postgres://linear:linear@localhost:5432/linear_test
REDIS_URL=redis://localhost:6379

# --- api ---
PORT=3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
BETTER_AUTH_URL=http://localhost:5173
APP_URL=http://localhost:5173

# --- object storage (S3-compatible: RustFS locally, MinIO/S3/R2 elsewhere) ---
S3_ENDPOINT=http://localhost:9000
# Optional: host the browser uses for upload/download links when it differs from S3_ENDPOINT
# (the production compose file sets it because the containers reach storage at http://storage:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=linear
S3_SECRET_KEY=linear-storage-secret
S3_BUCKET=linear-uploads

# --- GitHub App (api, worker) ---
# The integration stays off until all of these are set. In the App settings, set the
# Callback URL to $APP_URL/setup/github and tick "Request user authorization (OAuth)
# during installation". The private key PEM may use literal \n for newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# api only
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Webhook endpoint rejects all requests until this is configured.
GITHUB_WEBHOOK_SECRET=

# --- app (browser) ---
# Empty in dev: the Vite dev server proxies /api and /rpc to the API.
VITE_API_URL=
